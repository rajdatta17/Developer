# Browser-visible build path. Leave empty locally; the deploy workflow sets this.
NEXT_PUBLIC_BASE_PATH=

# Fallback weather location used by local and scheduled refreshes.
DAYBREAK_LOCATION_NAME=New York
DAYBREAK_LATITUDE=40.7128
DAYBREAK_LONGITUDE=-74.0060
DAYBREAK_TIMEZONE=America/New_York

# Provider selections. Mock sports providers require no secrets.
WEATHER_PROVIDER=open-meteo
CRICKET_PROVIDER=mock
FOOTBALL_PROVIDER=mock

# Add provider-specific secret names here when real sports adapters are enabled.
# Never put real values in this file.
CRICKET_API_KEY=
FOOTBALL_API_KEY=
